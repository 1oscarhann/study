# Copy to backend/.env for local dev. Never commit the real .env.

# dev | test | prod
ENVIRONMENT=dev

# Postgres. Locally: docker compose (see README). In prod: Neon's POOLED connection string
# (host contains "-pooler"), pasted as-is — sslmode etc. are handled for asyncpg.
DATABASE_URL=postgresql://rb:rb@localhost:5432/revision_battle
# Optional: Neon's DIRECT (non-pooled) string, used for migrations. Falls back to DATABASE_URL.
DATABASE_URL_DIRECT=

# Used for HMAC'ing IPs in rate limits etc. In prod: a long random string
# (python -c "import secrets; print(secrets.token_urlsafe(48))").
SECRET_KEY=dev-only-secret-key-change-me

# Shared with the Cloudflare Worker (wrangler secret put PROXY_SHARED_SECRET). Required in prod.
PROXY_SHARED_SECRET=

# The site's origin, for CORS and Origin checks. In prod e.g. https://revision-battle.<you>.workers.dev
FRONTEND_ORIGIN=http://localhost:5173

# Optional. Without it the app works; only AI question generation is disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_GENERATE=claude-opus-5-5
ANTHROPIC_MODEL_VERIFY=claude-opus-5-5
AI_BATCHES_PER_USER_PER_DAY=5
AI_BATCHES_GLOBAL_PER_DAY=200

# Distinct reports needed to auto-hide a question.
REPORT_HIDE_THRESHOLD=3
