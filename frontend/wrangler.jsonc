{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "revision-battle",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-13",
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    // Unknown paths serve index.html so React Router can handle them.
    "not_found_handling": "single-page-application",
    // Only /api/* runs the Worker (the proxy); everything else is a static asset.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Your Render service URL. PROXY_SHARED_SECRET is a secret: `wrangler secret put PROXY_SHARED_SECRET`.
    "BACKEND_URL": "https://revision-battle-api.onrender.com"
  },
  "observability": { "enabled": true }
}
